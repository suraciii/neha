target/

# Editor and OS files.
.DS_Store
**/.DS_Store

# Python interpreter caches are generated locally.
__pycache__/
*.py[cod]

# Local design-tooling state (Impeccable) is machine-local, not shared.
.impeccable/

# Diagnostic outputs from local runs. Scoped to the repository root so
# legitimate fixtures under data/ and tests/ stay tracked.
/test_*.png
/*.tif
/*.tiff
/*.jpg

# The browser client's dependencies and build output are local state.
ui/node_modules/
ui/dist/

# The desktop shell's dependencies and packaged output are local state.
apps/desktop/node_modules/
apps/desktop/dist/

# Generated desktop packaging resources.
apps/desktop/resources/

# Container deployment state: the record, secrets, Files, and Workspaces.
deploy/data/
deploy/.env
