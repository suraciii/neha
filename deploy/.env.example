# The public DNS name Caddy gets a certificate for.
NEHA_DOMAIN=neha.example.com

# The absolute path to this deployment's data directory on the Docker host.
# `docker compose` runs next to it, so `pwd` is usually the answer.
NEHA_HOST_DATA_DIR=/srv/neha/data

# A random shared secret for the Space -> Supervisor API.
NEHA_SUPERVISOR_TOKEN=change-me-to-a-long-random-value

# The worker image built from deploy/worker.Dockerfile.
NEHA_WORKER_IMAGE=neha-worker:dev

# 0: wake a worker when it has work; 1: keep every worker running.
NEHA_WORKER_ALWAYS_ON=0
# Stop an idle worker after this many seconds (default 10 minutes).
NEHA_WORKER_IDLE_SECONDS=600

# auto: the worker reaches the internet through the worker bridge.
# restricted: the worker has no route off the internal network.
# open: the worker uses the worker bridge explicitly.
NEHA_WORKER_EGRESS=auto
